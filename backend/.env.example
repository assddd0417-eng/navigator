DATABASE_URL=postgresql://relay:relay@localhost:5432/relay_ax
# hash = 개발·테스트용 결정적 임베더, bge_m3 = BGE-M3 (pip install ".[bge]")
EMBEDDER=hash
EMBEDDING_MODEL_PATH=BAAI/bge-m3
MATCH_TOP_K=20
MATCH_MIN_SCORE=0.35
HNSW_EF_SEARCH=100
# 연계이유 문장: template(기본) | llm  — llm 은 pip install ".[llm]" + ANTHROPIC_API_KEY 필요, 실패 시 템플릿으로 대체
RATIONALE_GENERATOR=template
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-...
