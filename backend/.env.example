DATABASE_URL=postgresql://relay:relay@localhost:5432/relay_ax
# hash = 개발·테스트용 결정적 임베더, bge_m3 = BGE-M3 (pip install ".[bge]")
EMBEDDER=hash
# --- EMBEDDER=bge_m3 일 때 ---
# 모델 이름(벡터 구분용)과 로드 경로. 경로가 Hugging Face 이름이면 첫 실행 때 내려받아 캐시(약 2.3GB)
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_PATH=BAAI/bge-m3
# auto = cuda → mps(Apple Silicon) → cpu
EMBEDDING_DEVICE=auto
EMBEDDING_MAX_SEQ_LENGTH=1024
EMBEDDING_BATCH_SIZE=16
# 폐쇄망: true 면 네트워크 없이 캐시·로컬 폴더에서만 로드 (EMBEDDING_MODEL_PATH=/opt/models/bge-m3 등)
EMBEDDING_OFFLINE=false
# EMBEDDING_CACHE_DIR=/opt/models/hf-cache
MATCH_TOP_K=20
MATCH_MIN_SCORE=0.35
HNSW_EF_SEARCH=100
