DATABASE_URL=postgresql://relay:relay@localhost:5432/relay_ax
# hash = 개발·테스트용 결정적 임베더, bge_m3 = BGE-M3 (pip install ".[bge]")
EMBEDDER=hash
# --- EMBEDDER=bge_m3 일 때 ---
# 모델 이름(벡터 구분용)과 로드 경로. 경로가 Hugging Face 이름이면 첫 실행 때 내려받아 캐시(약 2.3GB)
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_PATH=BAAI/bge-m3
# auto = cuda → mps(Apple Silicon) → cpu
EMBEDDING_DEVICE=auto
EMBEDDING_MAX_SEQ_LENGTH=1024
EMBEDDING_BATCH_SIZE=16
# 폐쇄망: true 면 네트워크 없이 캐시·로컬 폴더에서만 로드 (EMBEDDING_MODEL_PATH=/opt/models/bge-m3 등)
EMBEDDING_OFFLINE=false
# EMBEDDING_CACHE_DIR=/opt/models/hf-cache
MATCH_TOP_K=20
MATCH_MIN_SCORE=0.35
HNSW_EF_SEARCH=100
# 연계이유 문장: template(기본, 외부 전송 없음) | auto(키가 있으면 LLM) | llm
#   auto·llm 은 외부 API(Anthropic·OpenAI)로 수요·카드 정보와 근거 인용문(LLM_EVIDENCE_MAX_SECURITY 이하)을 보낸다.
#   폐쇄망·로컬 보안 환경에서는 template 로 둔다. 켜져 있는지는 /health 의 rationale.external 로 확인
RATIONALE_GENERATOR=template
# 제공자: anthropic (ANTHROPIC_API_KEY, 기본 모델 claude-opus-5-5) | openai (OPENAI_API_KEY, 기본 모델 gpt-5.5)
LLM_PROVIDER=anthropic
# LLM_MODEL=            # 비우면 제공자 기본 모델
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...

# 문서 업로드 (PDF·TXT·MD)
UPLOAD_MAX_MB=30
PDF_MAX_PAGES=1000
CHUNK_MAX_CHARS=1000

# 메일: mock(기본, 보내지 않음) | smtp
MAILER=mock
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # starttls(587) | ssl(465) | none
# SMTP_USER=navigator@example.com
# SMTP_PASSWORD=                # Gmail 은 앱 비밀번호
# SMTP_FROM=                    # 비우면 SMTP_USER
# SMTP_FROM_NAME=Navigator
